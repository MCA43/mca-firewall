{
    "name": "mca/firewall",
    "description": "IP whitelist/blacklist rules, middleware protection and admin UI for Laravel (MCA Access suite core).",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "mca", "firewall", "ip", "whitelist", "blacklist", "security"],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "mca/permission": "Root access middleware for firewall admin UI",
        "mca/hub": "MCA package hub integration",
        "mca/access-log": "Request access logging (Access suite)",
        "mca/access-intel": "IP health scoring and analytics (Access suite)"
    },
    "autoload": {
        "psr-4": {
            "Mca\\Firewall\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mca\\Firewall\\FirewallServiceProvider"
            ]
        },
        "mca": {
            "slug": "firewall",
            "title": {
                "en": "Firewall",
                "tr": "Güvenlik Duvarı"
            },
            "description": {
                "en": "IP whitelist/blacklist, CIDR rules, trash and request middleware.",
                "tr": "IP white/black list, CIDR kuralları, çöp kutusu ve istek middleware’i."
            },
            "route": "mca.firewall.index",
            "github": "https://github.com/MCA43/mca-firewall",
            "icon": "shield",
            "order": 30,
            "frameworks": ["laravel13"],
            "suite": "access",
            "suite_role": "core",
            "suggests": ["mca/access-log", "mca/access-intel", "mca/permission", "mca/hub"],
            "provides": ["ip-rules", "ip-middleware"]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
